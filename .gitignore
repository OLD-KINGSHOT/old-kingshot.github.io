# Publish ONLY the app — research scrapes, debug artifacts, and local tooling stay local.
/*
!/.gitignore
!/README.md
!/index.html
!/companion_repack.js
!/companion_src
!/server
# server secrets & artifacts stay local
/server/.owner_key.txt
/server/.t.json
/server/.v.json
/server/node_modules
/server/.wrangler
